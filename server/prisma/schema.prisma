generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A school tenant. Admins, teachers, sections, curriculums and school-wide
/// rubric templates all hang off one School so nothing leaks across schools.
model School {
  id              String           @id @default(uuid())
  name            String           @unique
  /// Optional school branding, set at registration. Null falls back to an
  /// initials placeholder and the default TulongGuro palette.
  logoUrl         String?
  brandColor      String?
  /// Grade at or above which a student is considered passing. DepEd uses 75.
  /// School-wide on purpose: "who needs help" has to mean the same thing in
  /// every class, or the analytics can't be compared across sections.
  passingGrade    Int              @default(75)
  /// Whether report-card grades run through the DepEd transmutation table.
  /// Ships OFF. Transmutation has a floor of 60 and never lowers a grade, so
  /// switching it on moves every grade upward — on the current data by up to
  /// 11 points, enough to flip a failing student to passing. That belongs to a
  /// deliberate decision by the school, not to whenever this code deploys.
  /// Analytics and at-risk detection always use the untransmuted grade.
  useTransmutation Boolean         @default(false)
  createdAt       DateTime         @default(now())
  curriculums     Curriculum[]
  gradingPolicies GradingPolicy[]
  rubricTemplates RubricTemplate[]
  sections        Section[]
  users           User[]
}

/// Component weights for one subject, e.g. Written Work 30 / Performance Task
/// 50 / Quarterly Assessment 20.
///
/// Keyed the same way as Curriculum — (school, gradeLevel, subject) — because
/// that is exactly the scope DepEd weights vary by, so a school that has set up
/// its curriculum already has the right buckets to hang these off.
///
/// Admin-owned. Deliberately no teacher-level override: a private rubric only
/// affects one activity, but a private weighting would mean two students in the
/// same subject get different quarter grades from identical scores.
model GradingPolicy {
  id         String   @id @default(uuid())
  schoolId   String
  gradeLevel String
  subject    String
  /// Percentages; stored as given and renormalised at read time so a policy
  /// that doesn't total 100 degrades sensibly instead of corrupting grades.
  wwWeight   Int      @default(30)
  ptWeight   Int      @default(50)
  qaWeight   Int      @default(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, gradeLevel, subject])
}

model User {
  id              String           @id @default(uuid())
  username        String           @unique
  name            String
  email           String?          @unique
  password        String
  /// ADMIN | TEACHER | STUDENT
  role            String
  schoolName      String?
  schoolId        String?
  createdAt       DateTime         @default(now())
  sectionId       String?
  taughtClasses   Class[]          @relation("TeacherClasses")
  gradingExamples GradingExample[]
  rubricTemplates RubricTemplate[] @relation("TeacherRubricTemplates")
  ownedSections   Section[]        @relation("TeacherSections")
  submissions     Submission[]
  school          School?          @relation(fields: [schoolId], references: [id])
  section         Section?         @relation("StudentSection", fields: [sectionId], references: [id])
}

model Section {
  id         String   @id @default(uuid())
  name       String
  /// Sections are segmented by grade level so a school roster stays navigable.
  gradeLevel String?
  teacherId  String
  schoolId   String?
  createdAt  DateTime @default(now())
  classes    Class[]
  school     School?  @relation(fields: [schoolId], references: [id])
  teacher    User     @relation("TeacherSections", fields: [teacherId], references: [id])
  students   User[]   @relation("StudentSection")
}

/// A school-wide curriculum for one grade level + subject, published by an
/// admin. Teachers get it suggested when they create a matching course shell.
model Curriculum {
  id          String             @id @default(uuid())
  schoolId    String
  gradeLevel  String
  subject     String
  title       String
  description String?
  sourceFile  String?
  createdAt   DateTime           @default(now())
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lessons     CurriculumLesson[]
  rubrics     RubricTemplate[]

  @@unique([schoolId, gradeLevel, subject])
}

/// Template lesson copied into a class's ClassLesson rows when a teacher
/// applies the curriculum to a new course shell.
model CurriculumLesson {
  id            String     @id @default(uuid())
  curriculumId  String
  title         String
  description   String?
  outputType    String     @default("Essay")
  weekNumber    Int?
  defaultRubric String?
  createdAt     DateTime   @default(now())
  curriculum    Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
}

model Class {
  id             String        @id @default(uuid())
  name           String
  gradeLevel     String?
  subject        String?
  schoolYear     String
  teacherId      String
  sectionId      String
  createdAt      DateTime      @default(now())
  curriculumFile String?
  activities     Activity[]
  section        Section       @relation(fields: [sectionId], references: [id])
  teacher        User          @relation("TeacherClasses", fields: [teacherId], references: [id])
  lessons        ClassLesson[]
}

model ClassLesson {
  id            String     @id @default(uuid())
  classId       String
  title         String
  description   String?
  outputType    String     @default("Essay")
  weekNumber    Int?
  defaultRubric String?
  createdAt     DateTime   @default(now())
  activities    Activity[]
  class         Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model Activity {
  id              String       @id @default(uuid())
  title           String
  type            String
  topic           String?
  points          Int
  classId         String
  instructions    String?
  deadline        String?
  submissionMode  String       @default("TEACHER_UPLOAD")
  additionalFiles String?
  rubric          String?
  classLessonId   String?
  maxAttempts     Int          @default(1)
  /// Which grading component this counts toward: WW, PT or QA. Null means the
  /// activity predates components and is treated as Written Work, so existing
  /// grades keep working untouched. Distinct from `type`, which is the
  /// pedagogical kind ("Essay") — a school needs both.
  component       String?
  createdAt       DateTime     @default(now())
  class           Class        @relation(fields: [classId], references: [id])
  classLesson     ClassLesson? @relation(fields: [classLessonId], references: [id])
  submissions     Submission[]
}

model Submission {
  id               String    @id @default(uuid())
  activityId       String
  studentId        String
  imageUrl         String?
  aiScore          Int?
  hitlScore        Int?
  aiFeedback       String?
  hitlFeedback     String?
  readingStrategy  String?
  rubricData       String?
  skillScores      String?
  covData          String?
  attemptCount     Int       @default(1)
  privacyViolation Boolean   @default(false)
  status           String    @default("PENDING")
  retainUntil      DateTime?
  archivedAt       DateTime?
  gradedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  activity         Activity  @relation(fields: [activityId], references: [id])
  student          User      @relation(fields: [studentId], references: [id])
}

model GradingExample {
  id              String   @id @default(uuid())
  teacherId       String
  activityType    String
  gradeLevel      String?
  aiFeedback      String
  teacherFeedback String
  aiScore         Int
  teacherScore    Int
  createdAt       DateTime @default(now())
  teacher         User     @relation(fields: [teacherId], references: [id])
}

model RubricTemplate {
  id           String      @id @default(uuid())
  name         String
  criteria     String
  /// Set for a teacher's private template; null for a school-wide one.
  teacherId    String?
  /// Set for an admin-published, school-wide template; null for a private one.
  schoolId     String?
  /// Segmentation: which grade level and subject this rubric is meant for.
  /// Null on both means "any" — the pre-segmentation default.
  gradeLevel   String?
  subject      String?
  /// Set when the rubric was extracted from an uploaded curriculum, so
  /// deleting that curriculum can clean up the rubrics it generated.
  curriculumId String?
  /// The lesson output type the rubric was generated for, e.g. Essay.
  outputType   String?
  createdAt    DateTime    @default(now())
  curriculum   Curriculum? @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  school       School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher      User?       @relation("TeacherRubricTemplates", fields: [teacherId], references: [id], onDelete: Cascade)
}
