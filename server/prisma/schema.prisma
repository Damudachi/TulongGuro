generator client {
  provider = "prisma-client-js"
}

// NOTE: Change to "postgresql" and update DATABASE_URL before deploying to production.
// For local development, keep "sqlite" with DATABASE_URL="file:./dev.db"
// For production, set DATABASE_URL to your Supabase PostgreSQL connection string.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  username   String   @unique
  name       String
  email      String?  @unique
  password   String
  role       String
  schoolName String?
  createdAt  DateTime @default(now())

  taughtClasses   Class[]   @relation("TeacherClasses")
  ownedSections   Section[] @relation("TeacherSections")
  sectionId       String?
  section         Section?  @relation("StudentSection", fields: [sectionId], references: [id])
  submissions     Submission[]
  gradingExamples GradingExample[]
  rubricTemplates RubricTemplate[] @relation("TeacherRubricTemplates")
}

model Section {
  id        String   @id @default(uuid())
  name      String
  teacherId String
  createdAt DateTime @default(now())

  teacher  User    @relation("TeacherSections", fields: [teacherId], references: [id])
  students User[]  @relation("StudentSection")
  classes  Class[]
}

model Class {
  id         String   @id @default(uuid())
  name       String
  gradeLevel String?
  subject    String?
  schoolYear String
  teacherId  String
  sectionId  String
  createdAt  DateTime @default(now())

  teacher    User       @relation("TeacherClasses", fields: [teacherId], references: [id])
  section    Section    @relation(fields: [sectionId], references: [id])
  activities Activity[]
}

model Activity {
  id              String   @id @default(uuid())
  title           String
  type            String
  topic           String?
  points          Int
  classId         String
  instructions    String?
  deadline        String?
  submissionMode  String   @default("TEACHER_UPLOAD")
  additionalFiles String?
  rubric          String?
  createdAt       DateTime @default(now())

  class       Class        @relation(fields: [classId], references: [id])
  submissions Submission[]
}

model Submission {
  id              String   @id @default(uuid())
  activityId      String
  studentId       String
  imageUrl        String?
  aiScore         Int?
  hitlScore       Int?
  aiFeedback      String?
  hitlFeedback    String?
  readingStrategy String?
  rubricData      String?
  skillScores     String?  // JSON: { vocabulary, punctuation, thematicFlow, sentenceStructure }
  covData         String?  // JSON: { originalScore, verifiedScore, conflict }
  privacyViolation Boolean  @default(false)
  status          String   @default("PENDING")
  retainUntil     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id])
  student  User     @relation(fields: [studentId], references: [id])
}

// Mini-RAG: stores meaningful teacher edits as few-shot grading examples
model GradingExample {
  id              String   @id @default(uuid())
  teacherId       String
  activityType    String   // "Essay", "Journal", etc.
  gradeLevel      String?
  aiFeedback      String
  teacherFeedback String
  aiScore         Int
  teacherScore    Int
  createdAt       DateTime @default(now())

  teacher User @relation(fields: [teacherId], references: [id])
}

model RubricTemplate {
  id        String   @id @default(uuid())
  name      String
  criteria  String   // JSON: Structured rubric configuration
  teacherId String
  teacher   User     @relation("TeacherRubricTemplates", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
