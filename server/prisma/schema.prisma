generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A school tenant. Admins, teachers, sections, curriculums and school-wide
/// rubric templates all hang off one School so nothing leaks across schools.
model School {
  id               String           @id @default(uuid())
  name             String           @unique
  /// Optional school branding, set at registration. Null falls back to an
  /// initials placeholder and the default TulongGuro palette.
  logoUrl          String?
  brandColor       String?
  /// PENDING | APPROVED | REJECTED — platform-operator review of a new school.
  /// Nobody belonging to a school can log in until it is APPROVED.
  ///
  /// Defaults to APPROVED, and /api/auth/register sets PENDING explicitly. That
  /// looks backwards, and it is deliberate: the default is what every existing
  /// row gets when this column is pushed, so defaulting to PENDING would lock
  /// every school already using the system out at the moment of deploy. Any
  /// future code path that creates a School must set status itself.
  status           String           @default("APPROVED")
  /// When a platform operator approved it, and who/why if it was refused.
  approvedAt       DateTime?
  rejectedReason   String?
  /// ── Proof that the school exists ──
  ///
  /// Registration is the only door anyone can walk up to, so it is the only
  /// place the platform can be flooded. The DepEd School ID is what makes that
  /// expensive: Philippine schools are a published, finite set, so a
  /// registration now has to name one that exists rather than any string.
  ///
  /// Unique, which is the real duplicate protection here. School *names* repeat
  /// legitimately across divisions — there are many "San Jose Elementary
  /// School" — so the name-unique constraint above is the weaker guard and this
  /// is the one that means something. Nullable because every school registered
  /// before this column existed has no ID, and locking them out to backfill a
  /// field would be a worse failure than the one it prevents.
  depedSchoolId    String?          @unique
  /// The masterlist's own name for that ID, stored as it was at registration.
  /// Kept so an operator sees what DepEd calls the school next to what the
  /// registrant typed, without a second lookup and without depending on the
  /// masterlist file still being the same one months later.
  officialName     String?
  /// MATCHED | NAME_MISMATCH | NOT_FOUND | NO_MASTERLIST — see depedMasterlist.js.
  /// Never blocks approval on its own; it decides what the operator is shown.
  verification     String?
  /// One line of human-readable detail behind the verdict — the division the
  /// matched record sits in, or why the names disagree.
  verificationNote String?
  /// A real, deliverable address for the school, distinct from the admin's
  /// @admin.com login (which is a synthetic domain with no mailbox behind it).
  /// Without this there was no way to contact a registering school at all,
  /// which left an operator with nothing to verify against but a typed name.
  contactEmail     String?
  /// Government permit / recognition document, required only when the School ID
  /// is not in the masterlist. That path exists for schools that are real but
  /// newer than our copy of the list; the document is what a human judges.
  proofUrl         String?
  /// Where the registration came from. Triage only — one address submitting
  /// twenty schools is the signature this whole column set exists to surface.
  registeredIp     String?
  /// The admin who registered this school — its super admin.
  ///
  /// Every admin already has total authority over their school's data, so this
  /// is not another tier of that. It answers a different question: who is
  /// accountable for *who else holds the keys*. Adding, promoting, demoting and
  /// resetting the password of an admin are the four actions that change the
  /// set of people who can reach a school, and letting any admin do them to any
  /// other meant a co-admin added for one term could remove the head teacher
  /// who added them. Those four are now the super admin's alone; everything
  /// else an admin can do is untouched.
  ///
  /// A plain String rather than a relation to User. A relation would need a
  /// matching back-reference on User, and schema changes here ship through
  /// `prisma db push` with no migration history to roll back — a nullable
  /// scalar column is the change with the smallest blast radius. Nullable for
  /// the same reason School.status defaults the way it does: every school that
  /// already exists gets NULL when this column is pushed, and locking those
  /// schools out of admin management until someone backfills them would be a
  /// worse failure than the one this prevents. resolveSuperAdminId() in
  /// server.js therefore falls back to the school's earliest ADMIN row, which
  /// is who registered it; scripts/backfill-school-owner.js writes that answer
  /// down permanently.
  ownerId          String?
  /// Grade at or above which a student is considered passing. DepEd uses 75.
  /// School-wide on purpose: "who needs help" has to mean the same thing in
  /// every class, or the analytics can't be compared across sections.
  passingGrade     Int              @default(75)
  /// Whether report-card grades run through the DepEd transmutation table.
  /// Ships OFF. Transmutation has a floor of 60 and never lowers a grade, so
  /// switching it on moves every grade upward — on the current data by up to
  /// 11 points, enough to flip a failing student to passing. That belongs to a
  /// deliberate decision by the school, not to whenever this code deploys.
  /// Analytics and at-risk detection always use the untransmuted grade.
  useTransmutation Boolean          @default(false)
  createdAt        DateTime         @default(now())
  curriculums      Curriculum[]
  gradingPolicies  GradingPolicy[]
  rubricTemplates  RubricTemplate[]
  sections         Section[]
  users            User[]
}

/// Component weights for one subject, e.g. Written Work 30 / Performance Task
/// 50 / Quarterly Assessment 20.
///
/// Keyed the same way as Curriculum — (school, gradeLevel, subject) — because
/// that is exactly the scope DepEd weights vary by, so a school that has set up
/// its curriculum already has the right buckets to hang these off.
///
/// Admin-owned. Deliberately no teacher-level override: a private rubric only
/// affects one activity, but a private weighting would mean two students in the
/// same subject get different quarter grades from identical scores.
model GradingPolicy {
  id         String   @id @default(uuid())
  schoolId   String
  gradeLevel String
  subject    String
  /// Percentages; stored as given and renormalised at read time so a policy
  /// that doesn't total 100 degrades sensibly instead of corrupting grades.
  wwWeight   Int      @default(30)
  ptWeight   Int      @default(50)
  qaWeight   Int      @default(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, gradeLevel, subject])
}

model User {
  id                String           @id @default(uuid())
  username          String           @unique
  name              String
  email             String?          @unique
  password          String
  /// ADMIN | TEACHER | STUDENT
  ///
  /// Deliberately a plain String, not a Prisma enum. An enum was tried and
  /// reverted: this is a plain-JavaScript codebase with no TypeScript, so the
  /// "compile-time safety" an enum is usually reached for does not exist here
  /// — it would only add a database-level constraint, and every write to this
  /// column is already a server-controlled literal, never user input. That is
  /// not worth a type-changing ALTER on the live User table in a project with
  /// no migration history (schema changes ship via `prisma db push`, which has
  /// no rollback path). Authorization drift is guarded instead by the
  /// ownership checks in the route handlers and by
  /// scripts/verify-route-authorization.js.
  role              String
  /// Sessions issued before this instant are refused.
  ///
  /// Tokens are stateless and carry their own expiry, so without this the only
  /// way to end a session early was to rotate AUTH_SECRET and sign out every
  /// user of every school at once. Bumping this signs out one person — which is
  /// what a stolen laptop, a shared classroom machine, or an admin resetting a
  /// teacher's password actually calls for.
  ///
  /// Null means "no revocation yet", which is every existing row.
  sessionsValidFrom DateTime?
  /// Date of birth, for learners enrolled from a class roster.
  ///
  /// Recorded because it seeds the pupil's first password (see enrolStudents):
  /// a Grade 6 learner can be told "your password is your birthday" and will
  /// remember it, where a generated string means the teacher re-issues it all
  /// year. It is knowable by classmates, so it is a starting credential rather
  /// than a secret — see the password-change note on the roster screen.
  birthdate         DateTime?
  /// light | dark | system — how this person wants the app to look.
  ///
  /// On the account rather than on the device, because the device is shared.
  /// A school computer lab, a classroom phone passed down a row, a teacher's
  /// laptop borrowed by a colleague: with the preference kept per browser, one
  /// person turning dark mode on turned it on for everyone who signed in after
  /// them. It is also the only way the choice follows someone from the lab PC
  /// to their own phone.
  ///
  /// Null means never chosen, which is treated as "follow the operating
  /// system" — deliberately distinct from an explicit "light", so a user who
  /// has said nothing still gets a dark app at night while one who chose light
  /// keeps it at any hour.
  themePreference   String?
  schoolName        String?
  schoolId          String?
  createdAt         DateTime         @default(now())
  sectionId         String?
  taughtClasses     Class[]          @relation("TeacherClasses")
  gradingExamples   GradingExample[]
  rubricTemplates   RubricTemplate[] @relation("TeacherRubricTemplates")
  ownedSections     Section[]        @relation("TeacherSections")
  submissions       Submission[]
  notifications     Notification[]
  badges            StudentBadge[]
  createdBadges     TeacherBadge[]   @relation("TeacherBadges")
  school            School?          @relation(fields: [schoolId], references: [id])
  section           Section?         @relation("StudentSection", fields: [sectionId], references: [id])
}

/// A badge a teacher wrote themselves, to hang off an activity of their own.
///
/// The fifteen built-in badges in badges.js describe patterns across a whole
/// term — an average sustained over five activities, a comeback in one subject
/// — and none of them can say "you passed the multiplication drill I set on
/// Tuesday". That is the gap this closes: a teacher names the reward, sets the
/// bar in percent on one activity, and the learner earns it by clearing it.
///
/// Owned by one teacher rather than the school. A school-wide badge would be
/// an admin's decision about what the whole school celebrates, and nothing
/// here proposes that; `schoolId` is carried only so the row stays attributable
/// after a teacher account is gone, never as a permission.
model TeacherBadge {
  id          String     @id @default(uuid())
  /// What the learner sees on the badge, e.g. "Times Table Champion".
  name        String
  /// The one line under the name. Optional: a well-named badge often needs no
  /// gloss, and an empty description falls back to the condition itself
  /// ("Score at least 80% on Times Table Drill").
  description String?
  /// A key from BADGE_ICONS in badges.js, e.g. "trophy". Stored as the key and
  /// not as markup or a class name, so the same badge can be drawn by the
  /// student page, the teacher's library and anything added later without the
  /// three of them having to agree on a rendering.
  icon        String     @default("award")
  /// A key from BADGE_COLORS in badges.js — a palette name, not a hex value,
  /// for the same reason. Unknown values fall back rather than failing.
  color       String     @default("royal")
  teacherId   String
  schoolId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  teacher     User       @relation("TeacherBadges", fields: [teacherId], references: [id], onDelete: Cascade)
  activities  Activity[]

  @@index([teacherId])
}

/// A badge a learner has earned, kept so it can never be taken away again.
///
/// Every other badge condition is a function of the learner's own work and
/// could be recomputed on demand. Class Champion cannot: it depends on how
/// classmates are doing, so a badge shown in October would vanish in June
/// because someone else improved — through no fault of the child holding it.
/// Recording the moment it was first reached is what makes "earned" mean
/// earned. The accepted trade is that a later grade correction no longer
/// un-earns a badge.
model StudentBadge {
  id        String   @id @default(uuid())
  /// The badge's stable id, e.g. "comeback-kid" — one of BADGE_IDS in
  /// badges.js — or "custom:<TeacherBadge id>" for a badge a teacher wrote.
  /// One column for both because everything downstream (the unique pair, the
  /// union at read time, "earned means earned") treats them identically; the
  /// prefix is the only thing that tells them apart, and badges.js owns it.
  studentId String
  badgeId   String
  /// The teacher badge's name as it stood when this was earned. Only set on a
  /// custom row, and only ever read as a fallback: the live TeacherBadge is
  /// preferred, so a rename shows through. It exists because a teacher's
  /// account being deleted takes their badges with it, and a learner's trophy
  /// room going blank where a badge used to be is the one outcome this table
  /// was created to prevent.
  label     String?
  earnedAt  DateTime @default(now())
  /// When the learner was actually shown the "you earned this" moment.
  ///
  /// Separate from earnedAt because the two genuinely differ: a badge is
  /// awarded by whichever dashboard load first computes it, and the child may
  /// well have closed the tab, been called to line up, or opened the app only
  /// long enough for it to load. Firing the celebration off "was this row
  /// inserted on this request" would then spend the moment on a screen nobody
  /// was looking at, and it could never come back.
  ///
  /// Null means "owed a celebration", so it survives any number of missed
  /// loads and fires exactly once, on any device. Backfilled to earnedAt for
  /// every row that predates this column — otherwise every learner already
  /// holding badges would meet a queue of confetti for wins from weeks ago.
  celebratedAt DateTime?
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeId])
  @@index([studentId])
}

/// A student-facing notification — "your grade was released," to start.
/// Deliberately minimal (BP-1): one flat table, no channels or preferences.
/// The gap this closes is that grades, deadlines, and releases were entirely
/// silent outside the app; it is not meant to become a notification platform.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  /// e.g. "GRADE_RELEASED" — a caller-defined tag, not a Prisma enum, since
  /// the set of notification types is expected to grow ad hoc as more events
  /// start notifying (deadlines, etc.) and each addition shouldn't need a
  /// schema migration the way User.role's fixed three values warranted one.
  type      String
  title     String
  body      String?
  /// Where the app should navigate to when this notification is opened —
  /// e.g. the released activity's review page. Optional: not every
  /// notification type will have somewhere to go.
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Section {
  id         String   @id @default(uuid())
  name       String
  /// Sections are segmented by grade level so a school roster stays navigable.
  gradeLevel String?
  /// The school year this section belongs to, e.g. "2026-2027". Nullable so
  /// the column could be added without a write to every existing row, and so
  /// a section whose year cannot be established is never hidden — unknown is
  /// treated as current, because filtering away a roster nobody can find again
  /// is worse than showing one extra.
  schoolYear String?
  teacherId  String
  schoolId   String?
  createdAt  DateTime @default(now())
  classes    Class[]
  school     School?  @relation(fields: [schoolId], references: [id])
  teacher    User     @relation("TeacherSections", fields: [teacherId], references: [id])
  students   User[]   @relation("StudentSection")
}

/// When a student moved between sections, and who moved them.
///
/// A User has exactly one Section, so a move repoints that single field and
/// leaves no trace of what came before. Every screen that finds a learner's
/// work by walking Section -> Class -> Activity -> Submission therefore loses
/// what they did before the move, and the section they arrive into shows them
/// MISSING against activities they were never present for. Nothing is deleted
/// by a move; it just becomes unreachable from the places that need it, and
/// misread by the places that find it.
///
/// This is the missing fact. `User.sectionId` still answers "where are they
/// now" and is unchanged; this answers "since when", which is what tells
/// "did not hand it in" from "had already left before it was set".
///
/// Append-only. schoolId is denormalized onto the row for the same reason
/// GradingAuditLog denormalizes studentId/activityId: the record has to stay
/// meaningful after the section it points at is deleted.
model SectionTransfer {
  id            String   @id @default(uuid())
  studentId     String
  /// Null on a learner's first enrolment — they came from nowhere.
  fromSectionId String?
  /// Null when a learner is unassigned rather than moved, which is what the
  /// admin remove-student route already does when they have submitted work.
  toSectionId   String?
  transferredAt DateTime @default(now())
  /// The teacher or admin who did it. Null for a system-generated row.
  actorId       String?
  schoolId      String?
  reason        String?
  createdAt     DateTime @default(now())

  @@index([studentId, transferredAt])
  @@index([fromSectionId])
  @@index([toSectionId])
}

/// A school-wide curriculum for one grade level + subject, published by an
/// admin. Teachers get it suggested when they create a matching course shell.
model Curriculum {
  id          String             @id @default(uuid())
  schoolId    String
  gradeLevel  String
  subject     String
  title       String
  description String?
  sourceFile  String?
  createdAt   DateTime           @default(now())
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lessons     CurriculumLesson[]
  rubrics     RubricTemplate[]

  @@unique([schoolId, gradeLevel, subject])
}

/// Template lesson copied into a class's ClassLesson rows when a teacher
/// applies the curriculum to a new course shell.
model CurriculumLesson {
  id               String     @id @default(uuid())
  curriculumId     String
  title            String
  description      String?
  outputType       String     @default("Essay")
  weekNumber       Int?
  /// The Learning Competencies this lesson covers, as a JSON array of strings.
  ///
  /// A DepEd curriculum guide states these per week, in their own column, and
  /// the extraction used to read past them — keeping a one-or-two sentence
  /// summary and nothing else. That summary is all the AI ever got about what
  /// a lesson was for, which is why a hardcoded Grade 6 English competency map
  /// existed alongside this table: it was the only place a specific "evaluate
  /// for X, then Y" instruction could come from, and it covered exactly one
  /// subject. Reading the column the document already has gives every subject
  /// the same thing, from the school's own scope and sequence.
  ///
  /// JSON rather than a related table because nothing queries an individual
  /// competency: they are read as a set, for one lesson, to be written into a
  /// grading prompt. Null means the document had none to give, or predates
  /// this column — both leave grading exactly as it was.
  competencies     String?
  defaultRubric    String?
  /// The school RubricTemplate this lesson's rubric was saved as, so picking
  /// the lesson in the Activity Builder selects that template by id rather
  /// than a detached copy under a different name. Deliberately not a foreign
  /// key: defaultRubric above stays the fallback, so a deleted template must
  /// degrade to "use the embedded copy", not cascade or block the delete.
  rubricTemplateId String?
  createdAt        DateTime   @default(now())
  curriculum       Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
}

model Class {
  id             String        @id @default(uuid())
  name           String
  gradeLevel     String?
  subject        String?
  schoolYear     String
  teacherId      String
  sectionId      String
  createdAt      DateTime      @default(now())
  curriculumFile String?
  activities     Activity[]
  section        Section       @relation(fields: [sectionId], references: [id])
  teacher        User          @relation("TeacherClasses", fields: [teacherId], references: [id])
  lessons        ClassLesson[]
}

model ClassLesson {
  id               String     @id @default(uuid())
  classId          String
  title            String
  description      String?
  outputType       String     @default("Essay")
  weekNumber       Int?
  /// The Learning Competencies this lesson covers, as a JSON array of strings.
  ///
  /// A DepEd curriculum guide states these per week, in their own column, and
  /// the extraction used to read past them — keeping a one-or-two sentence
  /// summary and nothing else. That summary is all the AI ever got about what
  /// a lesson was for, which is why a hardcoded Grade 6 English competency map
  /// existed alongside this table: it was the only place a specific "evaluate
  /// for X, then Y" instruction could come from, and it covered exactly one
  /// subject. Reading the column the document already has gives every subject
  /// the same thing, from the school's own scope and sequence.
  ///
  /// JSON rather than a related table because nothing queries an individual
  /// competency: they are read as a set, for one lesson, to be written into a
  /// grading prompt. Null means the document had none to give, or predates
  /// this column — both leave grading exactly as it was.
  competencies     String?
  defaultRubric    String?
  /// Carried over from CurriculumLesson when the curriculum is applied to a
  /// class — see the note there. Copy-on-apply is deliberate (HANDOFF §4), so
  /// this is a copy of the id, not a live link.
  rubricTemplateId String?
  createdAt        DateTime   @default(now())
  activities       Activity[]
  class            Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model Activity {
  id                String        @id @default(uuid())
  title             String
  type              String
  topic             String?
  /// Which grading term (1, 2 or 3) this activity belongs to.
  ///
  /// Null means untagged, which is what every activity created before this
  /// column existed is: there is no date range recorded anywhere that could
  /// place them, and guessing from `deadline` would silently file work under
  /// a term it was never part of. The gradebook groups those under "No term"
  /// rather than hiding them, so nothing disappears from a teacher's record
  /// because of a column they have not filled in yet.
  term              Int?
  points            Int
  classId           String
  instructions      String?
  /// The due date, as "YYYY-MM-DD". Work submitted after it is marked late.
  /// Resolved to 23:59:59 Philippine time — see isPastDeadline in server.js.
  deadline          String?
  /// Last date late work is still accepted, as "YYYY-MM-DD". Null means the
  /// activity closes at the deadline, which is how every activity behaved
  /// before this existed, so old rows keep their current behaviour.
  lateUntil         String?
  submissionMode    String        @default("TEACHER_UPLOAD")
  additionalFiles   String?
  rubric            String?
  classLessonId     String?
  maxAttempts       Int           @default(1)
  /// Which grading component this counts toward: WW, PT or QA. Null means the
  /// activity predates components and is treated as Written Work, so existing
  /// grades keep working untouched. Distinct from `type`, which is the
  /// pedagogical kind ("Essay") — a school needs both.
  component         String?
  /// The teacher badge a learner earns by passing this activity, if any.
  ///
  /// SetNull rather than Cascade, and deliberately so: deleting a badge must
  /// never delete the activity it was attached to, along with every mark
  /// recorded against it. The activity simply stops awarding anything.
  badgeId           String?
  /// The mark, as a whole percentage 1–100, at or above which the badge is
  /// earned. Percent rather than raw points because it is the unit already
  /// stored on Submission — a bar set in points would silently change meaning
  /// the moment `points` did.
  ///
  /// Separate from School.passingGrade, which decides who is failing the
  /// subject. A teacher setting a reward is answering a different question
  /// ("what is worth celebrating here"), and may well pitch it above the pass
  /// mark. Null exactly when badgeId is null; the two are written together.
  badgePassingScore Int?
  createdAt         DateTime      @default(now())
  class             Class         @relation(fields: [classId], references: [id])
  classLesson       ClassLesson?  @relation(fields: [classLessonId], references: [id])
  badge             TeacherBadge? @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  submissions       Submission[]

  @@index([badgeId])
}

model Submission {
  id                    String            @id @default(uuid())
  activityId            String
  studentId             String
  imageUrl              String?
  /// Percentage scores, 0–100.
  ///
  /// Float rather than Int because these are stored as a percentage but entered
  /// as raw points, and an integer percentage cannot represent most marks. A 7
  /// out of a 30-point activity is 23.33%, which rounded to 23 and displayed
  /// back as 6.9 points — so 135 of the 246 whole-point marks a teacher can
  /// enter on common activity sizes came back wrong somewhere in the gradebook,
  /// analytics or export. Widening the column is what makes points -> percent
  /// -> points lossless. Everything downstream still reads a percentage, and
  /// display sites round; only the stored value gained precision.
  aiScore               Float?
  hitlScore             Float?
  aiFeedback            String?
  hitlFeedback          String?
  readingStrategy       String?
  rubricData            String?
  skillScores           String?
  covData               String?
  attemptCount          Int               @default(1)
  /// Submitted after the activity's deadline but within its late window.
  /// A record, not a penalty: nothing in the grading engine reads this, so a
  /// teacher decides what a late mark is worth. Set per attempt, so a student
  /// who re-submits late after an on-time first attempt is marked late.
  isLate                Boolean           @default(false)
  /// True when the AI graded this without a real gradeLevel on the class —
  /// generateSubmissionFeedback silently defaults to "Grade 6" for curriculum
  /// context, language complexity, and score calibration when Class.gradeLevel
  /// is unset, so a Grade 11 class with that field left blank was graded and
  /// calibrated as if it were Grade 6 with nothing surfaced to the teacher.
  /// This is that surfacing: the HITL workspace shows a banner when true.
  gradeLevelAssumed     Boolean           @default(false)
  /// True when a rubric criterion scored below its band's maximum but the AI's
  /// own areasForGrowth didn't name a substantive, specific reason why — the
  /// exact contradiction GRADING_SYSTEM_INSTRUCTION's SCORE/FEEDBACK
  /// CONSISTENCY section tells the model to avoid, checked here in code
  /// because the prompt alone has already needed two follow-up fixes for it.
  /// Same treatment as gradeLevelAssumed: never blocks the save, just flags
  /// the paper for the teacher's second look in the HITL workspace.
  scoreFeedbackMismatch Boolean           @default(false)
  /// Set when the AI's own arithmetic disagrees with itself on this paper:
  /// the headline score does not match the criteria it is meant to be the sum
  /// of, or a criterion was scored outside the band the model itself labelled
  /// it with. Both were found in live data and neither is caught by
  /// scoreFeedbackMismatch, which asks whether a shortfall was *explained*,
  /// not whether the numbers add up.
  ///
  /// A sentence rather than a boolean, because "these two numbers disagree" is
  /// only actionable if the teacher is told which two. Null means they agree.
  /// Never corrects the score: a disagreement means the output is untrustworthy
  /// on this paper, and choosing one of its answers would be guessing which.
  rubricScoreNote       String?
  /// True when a rubric genuinely existed for this activity — the activity's
  /// own rubric or its lesson's defaultRubric — but its JSON could not be
  /// parsed, so grading silently fell through to a lower-priority tier (the
  /// topic's recommended template, or the hardcoded generic DepEd rubric)
  /// instead of the rubric the teacher actually authored. Distinct from an
  /// activity simply having no rubric at all, which is the fallback ladder
  /// working as designed and not something to flag. Same treatment as
  /// gradeLevelAssumed: never blocks the save, just tells the teacher in the
  /// HITL workspace that the paper wasn't graded against what they set up.
  rubricParseFailed     Boolean           @default(false)
  /// True when the AI returned a score outside 0-100 (or one that was not a
  /// finite number) and it had to be clamped to fit.
  ///
  /// The model is told to return 0-100, but the prompt also makes the scaling
  /// its job — "the total score = sum of all criterion scores, scaled to
  /// 0-100" — and a rubric whose criteria don't sum to 100 is exactly when it
  /// gets that arithmetic wrong. Nothing checked the result: `aiScore` was
  /// written straight from the model's JSON, so a 120 flowed into the class
  /// average, the descriptor band, the star award and the export as though it
  /// were real, while the teacher saw "120%" with no indication anything had
  /// gone wrong. Rubric JSON has been validated since validateRubric existed;
  /// the headline number it produces was not.
  ///
  /// Same treatment as gradeLevelAssumed: never blocks the save, just tells
  /// the teacher in the HITL workspace that the number was adjusted, so they
  /// look at the rubric breakdown rather than trusting the total.
  scoreOutOfRange       Boolean           @default(false)
  privacyViolation      Boolean           @default(false)
  /// Set when a teacher excuses a student from this activity — illness, a
  /// school representation, a family emergency.
  ///
  /// Standard in every LMS and previously absent here, which left a teacher
  /// two bad options: leave the row MISSING, which reads as delinquent and
  /// pulls nothing into the average, or invent a mark. The grading engine was
  /// already ready for this — computeGrade drops a component with nothing
  /// graded and renormalises the remaining weights — so an excused activity
  /// simply does not enter the calculation, exactly like one not yet set.
  ///
  /// Distinct from archivedAt, which is a retention/lifecycle concern: an
  /// excused activity is a live pedagogical decision about one student, and
  /// stays visible to them and to staff as "Excused" rather than disappearing.
  excusedAt             DateTime?
  /// Why, in the teacher's words. Shown to the student, so it is a note to
  /// them rather than an internal code — and recorded because "excused" with
  /// no reason is exactly the kind of adjustment a parent asks about later.
  excusedReason         String?
  /// Set only on rows a section transfer created — the pre-arrival activities
  /// auto-excused when a learner joined a section partway through.
  ///
  /// It is what makes a mis-click reversible without an undo screen: moving
  /// the learner back out deletes rows carrying this id that no human has
  /// touched (attemptCount 0, both scores null), and can never reach a mark a
  /// teacher entered. Nullable, so every existing row is "not created by a
  /// transfer" without a backfill.
  transferId            String?
  /// Where each page ends inside the stitched composite `imageUrl`, as a JSON
  /// array of ascending fractions of its total height, the last one exactly 1.
  /// Null for a single page, and for a PDF or Word file — neither has
  /// boundaries anything here can see.
  ///
  /// Multi-page work is flattened into one tall image on upload, which is what
  /// the AI reads and what the review pane shows. Nothing recorded where one
  /// page stopped, so a teacher who scanned page 3 twice, or shot a neighbour's
  /// paper by mistake, could only delete the whole submission — grade, feedback
  /// and all — and scan every page again. This is what makes one page
  /// removable on its own: Edit Upload cuts the stored composite back into
  /// pages at these boundaries, drops the one the teacher picked, and
  /// re-uploads the rest (see src/utils/submissionPages.js).
  ///
  /// Fractions rather than pixels because the composite is rescaled after it is
  /// stitched (and could be again); a proportion survives that, an offset does
  /// not. Nullable and additive, so submissions uploaded before this existed
  /// read as "page boundaries unknown" and keep the old all-or-nothing Remove
  /// rather than being wrongly described as single-page.
  pageBreaks            String?
  status                String            @default("PENDING")
  /// When the teacher published this result to the student.
  ///
  /// Separate from status GRADED, which only means the teacher has validated the
  /// draft. Teachers recalibrate partway down a class set — if paper 2 is
  /// published the moment it is approved, a standard that drifts by paper 20 can
  /// only be corrected in front of the student. Holding release until the whole
  /// set has been reviewed also stops grades trickling out to some pupils while
  /// their classmates are still waiting. Staff always see the un-released work;
  /// students only ever see rows where this is set.
  releasedAt            DateTime?
  retainUntil           DateTime?
  archivedAt            DateTime?
  gradedAt              DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  activity              Activity          @relation(fields: [activityId], references: [id])
  student               User              @relation(fields: [studentId], references: [id])
  auditLog              GradingAuditLog[]
}

/// Append-only record of what happened to a submission's grade, and when.
///
/// aiScore/hitlScore/releasedAt only ever show the CURRENT state — a teacher
/// can validate, then re-open and revise, then release, and nothing is left
/// behind showing what the AI originally said or when a human first signed
/// off on it. Standard LMS practice treats an AI-suggested score as a draft
/// until a human of record approves it (this app already does that correctly
/// via status GRADED gating release and analytics); this table is what lets
/// that approval be reconstructed later, e.g. if a parent or DepEd disputes a
/// grade months after the fact.
///
/// Deliberately minimal: an event name, an actor (null for the AI), and a
/// score snapshot — not a full feedback-text snapshot, which would duplicate
/// aiFeedback/hitlFeedback's own history for little audit value.
///
/// submissionId is nullable and SetNull on delete, not Cascade, so a purged
/// submission's history survives the purge instead of being deleted along
/// with it — a submission being past its legal retention window doesn't mean
/// a dispute about how it was graded can't still surface later. Because the
/// row would otherwise become context-free once its submission link is
/// gone, studentId/activityId/activityTitle/schoolId are captured directly
/// onto each row at write time (see logGradingEvent) rather than only being
/// reachable by following the submission relation.
model GradingAuditLog {
  id             String      @id @default(uuid())
  submissionId   String?
  /// AI_GRADED | TEACHER_VALIDATED | RELEASED
  event          String
  /// The teacher who acted, or null for an AI_GRADED row.
  actorId        String?
  score          Float?
  /// Denormalized onto the row (not just reachable via `submission`) so this
  /// event still identifies who/what it was about after a purge sets
  /// submissionId to null.
  studentId      String?
  activityId     String?
  activityTitle  String?
  schoolId       String?
  /// Only populated on a RELEASED event: the exact WW/PT/QA weights,
  /// transmutation setting, and passing grade in effect at the moment this
  /// grade was published to a student, serialized as JSON. GradingPolicy and
  /// School.useTransmutation are read live everywhere else in the app, so an
  /// admin correcting them later silently recomputes every previously-
  /// released grade the next time anyone opens the gradebook — this is the
  /// one place that still remembers what a parent actually saw on release day.
  policySnapshot String?
  createdAt      DateTime    @default(now())
  submission     Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([submissionId])
}

model GradingExample {
  id              String   @id @default(uuid())
  teacherId       String
  activityType    String
  gradeLevel      String?
  aiFeedback      String
  teacherFeedback String
  aiScore         Int
  teacherScore    Int
  createdAt       DateTime @default(now())
  teacher         User     @relation(fields: [teacherId], references: [id])
}

model RubricTemplate {
  id           String      @id @default(uuid())
  name         String
  criteria     String
  /// Set for a teacher's private template; null for a school-wide one.
  teacherId    String?
  /// Set for an admin-published, school-wide template; null for a private one.
  schoolId     String?
  /// Segmentation: which grade level and subject this rubric is meant for.
  /// Null on both means "any" — the pre-segmentation default.
  gradeLevel   String?
  subject      String?
  /// Set when the rubric was extracted from an uploaded curriculum, so
  /// deleting that curriculum can clean up the rubrics it generated.
  curriculumId String?
  /// The lesson output type the rubric was generated for, e.g. Essay.
  outputType   String?
  createdAt    DateTime    @default(now())
  curriculum   Curriculum? @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  school       School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher      User?       @relation("TeacherRubricTemplates", fields: [teacherId], references: [id], onDelete: Cascade)
}

/// One row per request actually sent to the model provider.
///
/// Exists for the Alpha-stage technical observation: latency per request, and
/// how many requests a day's checking really consumed. Neither was recoverable
/// before — timing was never measured, and the quota tally lives in
/// `gradingPool[].used`, an in-memory counter that resets on every restart and
/// rolls at midnight. A study that has to report those two numbers cannot read
/// them from a counter that forgets.
///
/// One row per *attempt*, not per paper: a retry is a second request against
/// the provider's allowance, so counting papers would under-report the spend.
/// Writes are fire-and-forget and failures are swallowed — observation must
/// never be able to fail a teacher's grading run.
///
/// Deliberately carries nothing about the paper: no submission link, no student,
/// no prompt or response text. It answers "how did the service behave", and the
/// pairing of AI draft to teacher decision is GradingAuditLog's job.
model AiRequestLog {
  id        String   @id @default(uuid())
  /// GRADING | ASSIST | EXTRACT | PARSE | SELFCHECK | OTHER — which call site.
  purpose   String
  /// The model label the request was actually sent to, e.g. "gemini-3.6-flash#1".
  model     String?
  /// 0 for the first try; 1+ means this row is a retry of the same logical call.
  attempt   Int      @default(0)
  /// Wall-clock milliseconds from dispatch to response or error, including any
  /// wait for a concurrency slot — which is what a teacher actually experiences.
  latencyMs Int
  ok        Boolean
  /// OK | QUOTA | DAILY_QUOTA | TRANSIENT | BAD_IMAGE | ERROR
  outcome   String
  /// Truncated provider message on failure. Provider errors describe the
  /// request, not the paper, so nothing about a learner reaches this column.
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([purpose, createdAt])
}

/// Who was granted or lost school-admin access, and who did it.
///
/// A school's admin can now create and demote other admins of the same school
/// (see the /api/admin/:adminId/admins routes). That is the right place for
/// the decision — an admin they create can do nothing they could not already
/// do themselves, and routing it through a developer would make production
/// database access a routine support step. What it does need is a record:
/// "who gave this person the keys, and when" is the first question anyone
/// asks when a school's data has been changed by someone unexpected, and
/// User.role only ever shows the current answer.
///
/// Names and emails are denormalized onto the row the same way GradingAuditLog
/// denormalizes its subject, and for the same reason: a demoted admin can
/// later be deleted as a teacher, and a row that could only identify them by
/// a dangling id would be worthless at exactly the moment it is read. Nothing
/// here is a foreign key, so no delete anywhere can cascade this history away.
model AdminAuditLog {
  id          String   @id @default(uuid())
  schoolId    String
  /// ADMIN_CREATED | ADMIN_PROMOTED | ADMIN_DEMOTED | ADMIN_PASSWORD_RESET
  event       String
  /// The admin who performed it. Null only for a row written by a script.
  actorId     String?
  actorName   String?
  targetId    String?
  targetName  String?
  targetEmail String?
  createdAt   DateTime @default(now())

  @@index([schoolId, createdAt])
}
