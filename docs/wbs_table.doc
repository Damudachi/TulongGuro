<html xmlns:o="urn:schemas-microsoft-com:office:office"
xmlns:w="urn:schemas-microsoft-com:office:word"
xmlns="http://www.w3.org/TR/REC-html40">
<head>
    <meta charset="utf-8">
    <title>WBS Table</title>
    <style>
        table { border-collapse: collapse; width: 100%; font-family: "Times New Roman", Times, serif; font-size: 11pt; }
        th, td { border: 1px solid black; padding: 6px; text-align: left; vertical-align: top; }
        th { background-color: #1B2A4A; color: white; font-weight: bold; }
        tr.phase td { font-weight: bold; background-color: #E8EAF6; }
        tr.section td { font-weight: bold; background-color: #F5F5F5; }
        td.wbs { width: 10%; }
        td.name { width: 50%; }
        td.date { width: 15%; }
        td.days { width: 10%; text-align: center; }
    </style>
</head>
<body>
    <h2>TulongGuro: Work Breakdown Structure (WBS)</h2>
    <table>
        <thead>
            <tr>
                <th class="wbs">WBS #</th>
                <th class="name">Task Name</th>
                <th class="date">Start</th>
                <th class="date">End</th>
                <th class="days">Days</th>
            </tr>
        </thead>
        <tbody>
            <tr class="phase">
                <td class="wbs">1</td>
                <td class="name">Project Planning, Analysis and Design</td>
