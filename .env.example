# ──────────────────────────────────
# TulongGuro LMS — Environment Variables
# ──────────────────────────────────
# Copy this file to .env and fill in the values.

# ── Frontend (Vite) ──
# Set this to your Render.com backend URL in Vercel dashboard
# VITE_API_URL=https://tulongguro-api.onrender.com

# ── Backend (server/.env) ──
# Supabase PostgreSQL connection string (from Supabase Dashboard > Settings > Database)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Gemini API Key (from Google AI Studio)
GEMINI_API_KEY="your-gemini-api-key-here"

# Supabase Storage (from Supabase Dashboard > Settings > API)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_KEY="your-supabase-anon-key-here"

# Server
PORT=3000
NODE_ENV=production
